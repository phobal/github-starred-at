{
  "manifest_version": 3,
  "name": "GitHub Starred At",
  "description": "Show the time when you starred a repository on GitHub repository pages.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/png_icon-16.png",
    "32": "icons/png_icon-32.png",
    "48": "icons/png_icon-48.png",
    "128": "icons/png_icon-128.png",
    "256": "icons/png_icon-256.png"
  },
  "action": {
    "default_title": "GitHub Starred At",
    "default_popup": "src/options.html",
    "default_icon": {
      "16": "icons/png_icon-16.png",
      "32": "icons/png_icon-32.png",
      "48": "icons/png_icon-48.png",
      "128": "icons/png_icon-128.png"
    }
  }
}
